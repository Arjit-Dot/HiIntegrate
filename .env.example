# Placeholder NAMES only. Copy this file to .env and fill in real values there.
# Never commit .env. See docs/decisions.md D-7 and D-10.

# Database and encryption
DATABASE_URL=
POSTGRES_PASSWORD=
ENCRYPTION_KEY=

# Email alerts (D-5.3). The password is the secret named smtp_password.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_FROM=

# AI extras (optional)
LLM_API_KEY=

# Secrets are read from SECRET_<NAME> until the encrypted store exists (Phase 2).
# The name is the one used in a config's `secret:` field, in upper case.
SECRET_GITHUB_TOKEN=
SECRET_JIRA_TOKEN=
SECRET_OKTA_TOKEN=
SECRET_SMTP_PASSWORD=
