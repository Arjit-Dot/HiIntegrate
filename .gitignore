# Secrets and local data (docs/decisions.md D-7.4). Never commit these.
# Every .env file is ignored on purpose, including .env.example. The README lists the variable names instead.
# Note: /secrets/ is anchored to the repo root, so the backend/app/secrets package is not ignored.
.env
.env.*
*.db
*.sqlite
*.sqlite3
/secrets/
/.secrets/

# Dependencies and build output
node_modules/
__pycache__/
*.pyc
.venv/
dist/
*.tsbuildinfo
.pytest_cache/
.ruff_cache/
build/

# Editors and the operating system
.DS_Store
.idea/
.vscode/
CLAUDE.md

# TLS certificates and keys (S-13)
certs/
*.pem
*.key

# Team working notes, not part of the product (kept on disk, not published)
catchup.md
Finaltester.md
presentation.txt
roadmap.md
present/

# Test, coverage and tool leftovers
.coverage
htmlcov/
coverage/
*.log
*.swp
*.tmp
.claude/
